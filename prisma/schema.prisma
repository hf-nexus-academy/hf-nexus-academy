// =========================================================
// HF Nexus Academy — Prisma Schema
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseCategory {
  QURAN
  HADITH
  FIQH
  ARABIC
  ISLAMIC_FOUNDATIONS
  AQEEDAH
  LOGIC
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  LATE
  MISSING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  ANNOUNCEMENT
  CLASS_REMINDER
  ASSIGNMENT
  PAYMENT
  CERTIFICATE
  SYSTEM
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PlanTier {
  STARTER
  STANDARD
  PREMIUM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  ENROLLED
  CLOSED_LOST
}

// ---------------------------------------------------------
// AUTH / USER
// ---------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            Role      @default(STUDENT)
  country         String?
  whatsapp        String?
  timezone        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  student         Student?
  teacher         Teacher?

  passwordResetTokens PasswordResetToken[]
  verificationRequests VerificationRequest[]
  notifications   Notification[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model VerificationRequest {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ---------------------------------------------------------
// STUDENT / TEACHER PROFILES
// ---------------------------------------------------------

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  age         Int?
  guardianName String?
  bio         String?  @db.Text
  joinedAt    DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  submissions  Submission[]
  attendances  Attendance[]
  certificates Certificate[]
  payments     Payment[]
  notes        StudentNote[]

  @@index([userId])
}

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  title           String? // e.g. "Mufti"
  bio             String   @db.Text
  specializations String[]
  experienceYears Int?
  photoUrl        String?
  isPublished     Boolean  @default(true)
  displayOrder    Int      @default(0)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     Course[]
  lessons     Lesson[]
  assignments Assignment[]
  attendanceMarked Attendance[]

  @@index([slug])
}

// ---------------------------------------------------------
// COURSES / LESSONS
// ---------------------------------------------------------

model Course {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  subtitle      String?
  description   String         @db.Text
  category      CourseCategory
  level         CourseLevel    @default(BEGINNER)
  durationWeeks Int?
  coverImageUrl String?
  isPublished   Boolean        @default(true)
  teacherId     String?
  // Optional fixed monthly price for courses sold individually (e.g. Qudoori, Hidayah)
  // rather than bundled under the Starter/Standard/Premium subscription plans.
  priceMonthlyCents Int?
  priceCurrency     String?    @default("USD")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  modules     CourseModule[]

  @@index([category])
  @@index([slug])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id            String   @id @default(cuid())
  courseId      String
  moduleId      String?
  teacherId     String?
  title         String
  description   String?  @db.Text
  videoUrl      String?
  resourceUrl   String?
  order         Int      @default(0)
  durationMins  Int?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule? @relation(fields: [moduleId], references: [id])
  teacher     Teacher?      @relation(fields: [teacherId], references: [id])
  assignments Assignment[]

  @@index([courseId])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  courseId   String
  status     EnrollmentStatus @default(ACTIVE)
  progress   Int              @default(0) // percentage 0-100
  startedAt  DateTime         @default(now())
  completedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// ---------------------------------------------------------
// ASSIGNMENTS / SUBMISSIONS
// ---------------------------------------------------------

model Assignment {
  id          String   @id @default(cuid())
  lessonId    String?
  teacherId   String
  title       String
  instructions String  @db.Text
  dueAt       DateTime?
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())

  lesson      Lesson?      @relation(fields: [lessonId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  submissions Submission[]

  @@index([teacherId])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?          @db.Text
  fileUrl      String?
  status       AssignmentStatus @default(SUBMITTED)
  score        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------
// ATTENDANCE
// ---------------------------------------------------------

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  teacherId String
  courseId  String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  notes     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([studentId, date])
  @@index([courseId])
}

// ---------------------------------------------------------
// NOTES / RESOURCES
// ---------------------------------------------------------

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ---------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String            @db.Text
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------------------
// CERTIFICATES
// ---------------------------------------------------------

model Certificate {
  id          String   @id @default(cuid())
  studentId   String
  courseTitle String
  certificateNo String @unique
  issuedAt    DateTime @default(now())
  fileUrl     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ---------------------------------------------------------
// PAYMENTS / BILLING
// ---------------------------------------------------------

model Payment {
  id              String          @id @default(cuid())
  studentId       String
  provider        PaymentProvider
  providerRef     String          @unique // Stripe charge/session id or PayPal order id
  plan            PlanTier
  billingCycle     BillingCycle    @default(MONTHLY)
  amountCents     Int
  currency        String          @default("USD")
  status          PaymentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([providerRef])
}

// ---------------------------------------------------------
// BLOG
// ---------------------------------------------------------

model BlogPost {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  excerpt       String
  content       String         @db.Text
  coverImageUrl String?
  category      CourseCategory
  authorName    String
  status        BlogStatus     @default(DRAFT)
  publishedAt   DateTime?
  metaTitle     String?
  metaDescription String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])
}

// ---------------------------------------------------------
// CONTACT / LEADS (Free Trial + Contact form)
// ---------------------------------------------------------

model ContactLead {
  id               String     @id @default(cuid())
  fullName         String
  email            String
  whatsapp         String?
  country          String?
  age              Int?
  courseInterest   CourseCategory?
  message          String?    @db.Text
  source           String     @default("free_trial") // "free_trial" | "contact"
  status           LeadStatus @default(NEW)
  createdAt        DateTime   @default(now())

  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------
// TESTIMONIALS (admin-managed, placeholders only at launch)
// ---------------------------------------------------------

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  country     String?
  courseTaken String?
  quote       String   @db.Text
  rating      Int      @default(5)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isPublished])
}

// ---------------------------------------------------------
// ANNOUNCEMENTS (admin broadcast)
// ---------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  audience  Role[]
  createdAt DateTime @default(now())
}
