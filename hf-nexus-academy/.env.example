# =========================================
# HF Nexus Academy — Environment Variables
# =========================================
# Copy this file to .env.local for local development
# and configure the same keys in your Vercel project settings for production.

# -------------------------
# App
# -------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HF Nexus Academy"

# -------------------------
# Database (PostgreSQL)
# -------------------------
# Use a pooled connection string for serverless (e.g. Neon, Supabase, or Vercel Postgres).
# DIRECT_URL is used by Prisma Migrate and should bypass the connection pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hf_nexus_academy?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/hf_nexus_academy?schema=public"

# -------------------------
# NextAuth
# -------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -------------------------
# Email (Resend) — verification, password reset, notifications
# -------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="HF Nexus Academy <noreply@hf-nexus.com>"

# -------------------------
# Stripe
# -------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe Price IDs (created in Stripe Dashboard, map to pricing plans)
STRIPE_PRICE_STARTER_MONTHLY="price_xxxxxxxxxxxxx"
STRIPE_PRICE_STANDARD_MONTHLY="price_xxxxxxxxxxxxx"
STRIPE_PRICE_PREMIUM_MONTHLY="price_xxxxxxxxxxxxx"

# -------------------------
# PayPal
# -------------------------
# Webhook endpoint to register in PayPal Developer Dashboard: {NEXT_PUBLIC_APP_URL}/api/webhooks/paypal
# Stripe webhook endpoint to register in Stripe Dashboard: {NEXT_PUBLIC_APP_URL}/api/webhooks/stripe
PAYPAL_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYPAL_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYPAL_MODE="sandbox" # "sandbox" or "live"
PAYPAL_WEBHOOK_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -------------------------
# WhatsApp / Contact
# -------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="+10000000000"
CONTACT_RECEIVER_EMAIL="admissions@hf-nexus.com"

# -------------------------
# Calendly (Free Trial booking)
# -------------------------
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/hf-nexus-academy/free-trial"

# -------------------------
# Rate limiting (Upstash Redis) — optional but recommended in production
# -------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -------------------------
# File storage (Vercel Blob) — teacher lesson uploads, certificates
# -------------------------
BLOB_READ_WRITE_TOKEN=""

# -------------------------
# Analytics (optional)
# -------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
