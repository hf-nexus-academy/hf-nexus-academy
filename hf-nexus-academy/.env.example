# =========================================
# HF Nexus Academy — Environment Variables
# =========================================
# Copy this file to .env.local for local development
# and configure the same keys in your Vercel project settings for production.

# -------------------------
# App
# -------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HF Nexus Academy"

# -------------------------
# Database (PostgreSQL)
# -------------------------
# Use a pooled connection string for serverless (e.g. Neon, Supabase, or Vercel Postgres).
# DIRECT_URL is used by Prisma Migrate and should bypass the connection pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hf_nexus_academy?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/hf_nexus_academy?schema=public"

# -------------------------
# NextAuth
# -------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -------------------------
# Email (Resend) — verification, password reset, notifications
# -------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="HF Nexus Academy <noreply@hf-nexus.com>"

# -------------------------
# Contact
# -------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="+923142166677"
CONTACT_RECEIVER_EMAIL="admissions@hf-nexus.com"

# -------------------------
# Calendly (Free Trial booking)
# -------------------------
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/hf-nexus-academy/free-trial"

# -------------------------
# Rate limiting (Upstash Redis) — optional but recommended in production
# -------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -------------------------
# File storage (Vercel Blob) — teacher lesson uploads, certificates
# -------------------------
BLOB_READ_WRITE_TOKEN=""

# -------------------------
# Analytics (optional)
# -------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
